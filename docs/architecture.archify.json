  "cards": [
    {
      "dot": "cyan",
      "title": "请求与回程",
      "items": [
        "POST /generations 建立运行，202 返回 run_id",
        "GET /events/runs/{id} 以 SSE 实时推送进度",
        "JWT 登录鉴权：routers/auth.py + security.py"
      ]
    },
    {
      "dot": "emerald",
      "title": "Agent 与工具",
      "items": [
        "LangGraph 仅 plan、verify 两个节点，planner 用 qwen-plus",
        "UI 工具栏与 Agent 共用同一套 21 种工具注册表",
        "重计算经 arq 队列异步执行，不阻塞 API"
      ]
    },
    {
      "dot": "amber",
      "title": "执行与外部依赖",
      "items": [
        "DashScope：qwen-image-3.0-pro 文生图，qwen-image-edit-max 局部编辑",
        "本地 CV：rembg(u2net)、SAM 点选、OCR，缓存于 cv_models 卷",
        "providers 层可切换 mock / dashscope，便于离线开发"
      ]
    },
    {
      "dot": "rose",
      "title": "存储与部署",
      "items": [
        "PostgreSQL：用户、运行与图层结构（JSONB 持久化）",
        "MinIO：S3 协议存图，公开端点 :7313 供前端直读",
        "app 与 worker 仅在 docker compose --profile deploy 启动"
      ]
    }
  ]
